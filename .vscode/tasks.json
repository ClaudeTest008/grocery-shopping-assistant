{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Pub Get",
      "type": "shell",
      "command": "flutter pub get",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Flutter: Analyze",
      "type": "shell",
      "command": "flutter analyze",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Flutter: Test",
      "type": "shell",
      "command": "flutter test",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Flutter: Test with Coverage",
      "type": "shell",
      "command": "flutter test --coverage",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Verify (format + analyze + test)",
      "detail": "Everything CI checks, in one task.",
      "type": "shell",
      "command": "pwsh -NoProfile -File scripts/verify.ps1",
      "windows": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1"
      },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": false }
    },
    {
      "label": "Flutter: Run (Windows)",
      "type": "shell",
      "command": "flutter run -d windows",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Flutter: Run (Chrome)",
      "type": "shell",
      "command": "flutter run -d chrome",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Flutter: Run (Android)",
      "type": "shell",
      "command": "flutter run -d android",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Start Development",
      "detail": "pub get, then run Windows desktop and Chrome side by side.",
      "dependsOrder": "sequence",
      "dependsOn": ["Flutter: Pub Get", "Dev: Windows + Chrome"],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Dev: Windows + Chrome",
      "dependsOrder": "parallel",
      "dependsOn": ["Flutter: Run (Windows)", "Flutter: Run (Chrome)"],
      "problemMatcher": []
    },
    {
      "label": "Flutter: Build Windows",
      "type": "shell",
      "command": "flutter build windows --release",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Flutter: Clean Windows Build",
      "detail": "Drops build/windows so the next build reconfigures CMake from scratch.",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path build/windows) { Remove-Item -Recurse -Force build/windows; Write-Host 'Removed build/windows' } else { Write-Host 'build/windows already clean' }\"",
      "problemMatcher": []
    },
    {
      "label": "Flutter: Build Web",
      "type": "shell",
      "command": "flutter build web --release",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Flutter: Build APK",
      "type": "shell",
      "command": "flutter build apk --release",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Flutter: Clean",
      "type": "shell",
      "command": "flutter clean",
      "problemMatcher": []
    },
    {
      "label": "Dart: Format",
      "type": "shell",
      "command": "dart format .",
      "problemMatcher": []
    },
    {
      "label": "Build Runner: Build",
      "type": "shell",
      "command": "dart run build_runner build --delete-conflicting-outputs",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Build Runner: Watch",
      "type": "shell",
      "command": "dart run build_runner watch --delete-conflicting-outputs",
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
